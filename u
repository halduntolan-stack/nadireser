#!/bin/bash
# Nadir Eser panel güncellemesi
set -e
APP=/opt/nadireser-panel
[ -d "$APP" ] || { echo "Panel kurulu değil"; exit 1; }
TMP=$(mktemp -d)
sed '1,/^__PAYLOAD__$/d' "$0" | base64 -d > $TMP/u.tgz
tar -xzf $TMP/u.tgz -C $APP
chown -R nadirpanel:nadirpanel $APP
systemctl restart nadireser-panel
sleep 2
systemctl is-active --quiet nadireser-panel && echo "Güncelleme tamam, panel çalışıyor" || { echo "Servis başlamadı: journalctl -u nadireser-panel -n 50"; exit 1; }
exit 0
