#!/usr/bin/env bash
# Nadir Eser yönetim paneli kurulumu (Ubuntu 22.04/24.04). root olarak çalıştırın.
set -euo pipefail
DOMAIN="${DOMAIN:-yonetim.nadireser.com.tr}"
SELF="$(readlink -f "$0")"
APP=/opt/nadireser-panel
EMAIL="${CERT_EMAIL:-halduntolan@gmail.com}"
[ "$(id -u)" = 0 ] || { echo "root olmalı"; exit 1; }
export DEBIAN_FRONTEND=noninteractive

echo "==> Paketler"
apt-get update -y >/dev/null
apt-get install -y curl ca-certificates nginx certbot python3-certbot-nginx build-essential python3 >/dev/null
NODEV=$(node -v 2>/dev/null | sed 's/v//;s/\..*//' || echo 0)
if [ "${NODEV:-0}" -lt 20 ]; then
  echo "==> Node.js 22 kuruluyor"
  curl -fsSL https://deb.nodesource.com/setup_22.x | bash - >/dev/null
  apt-get install -y nodejs >/dev/null
fi

echo "==> Uygulama indiriliyor"
id nadirpanel >/dev/null 2>&1 || useradd --system --home $APP --shell /usr/sbin/nologin nadirpanel
mkdir -p $APP/data
TMP=$(mktemp -d)
sed '1,/^__PAYLOAD__$/d' "$SELF" | base64 -d > $TMP/p.tar.gz
tar -xzf $TMP/p.tar.gz -C $TMP
cp -r $TMP/panel-app/server.js $TMP/panel-app/package.json $TMP/panel-app/seed-works.json $APP/
rm -rf $APP/public; cp -r $TMP/panel-app/public $APP/public
rm -rf $TMP
cd $APP && npm install --omit=dev --no-audit --no-fund >/dev/null
chown -R nadirpanel:nadirpanel $APP

echo "==> Servis"
cat > /etc/systemd/system/nadireser-panel.service <<UNIT
[Unit]
Description=Nadir Eser yönetim paneli
After=network.target
[Service]
User=nadirpanel
WorkingDirectory=$APP
Environment=PORT=3100
Environment=PUBLIC_URL=https://$DOMAIN
Environment=DATA_DIR=$APP/data
ExecStart=/usr/bin/node $APP/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=$APP/data
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload

# ilk kurulumda rastgele parola
if ! runuser -u nadirpanel -- env DATA_DIR=$APP/data node -e "const D=require('$APP/node_modules/better-sqlite3');const d=new D('$APP/data/panel.db');d.exec('CREATE TABLE IF NOT EXISTS settings (k TEXT PRIMARY KEY, v TEXT)');process.exit(d.prepare(\"SELECT 1 FROM settings WHERE k='admin_pw'\").get()?0:1)"; then
  PASS=$(tr -dc 'A-HJ-NP-Za-km-z2-9' </dev/urandom | head -c 14)
  runuser -u nadirpanel -- env DATA_DIR=$APP/data node $APP/server.js --set-password "$PASS" >/dev/null
  NEWPW="$PASS"
else NEWPW=""; fi
systemctl enable --now nadireser-panel >/dev/null
systemctl restart nadireser-panel
sleep 2; systemctl is-active --quiet nadireser-panel || { echo "Servis başlamadı: journalctl -u nadireser-panel -n 50"; exit 1; }

echo "==> Nginx"
cat > /etc/nginx/sites-available/nadireser-panel <<NG
server {
  listen 80;
  listen [::]:80;
  server_name $DOMAIN;
  client_max_body_size 12m;
  location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$remote_addr;
    proxy_set_header X-Forwarded-Proto \$scheme;
  }
}
NG
ln -sf /etc/nginx/sites-available/nadireser-panel /etc/nginx/sites-enabled/nadireser-panel
nginx -t >/dev/null 2>&1 && systemctl reload nginx

echo "==> SSL"
if certbot --nginx -d "$DOMAIN" --non-interactive --agree-tos -m "$EMAIL" --redirect >/dev/null 2>&1; then
  SSL="https://$DOMAIN"
else
  SSL="http://$DOMAIN (SSL alınamadı: $DOMAIN için DNS A kaydı 167.233.245.2 olmalı; kayıt yayılınca şunu çalıştırın: certbot --nginx -d $DOMAIN --agree-tos -m $EMAIL --redirect)"
fi
echo
echo "=========================================="
echo " KURULUM TAMAM"
echo " Adres : $SSL"
if [ -n "$NEWPW" ]; then echo " Parola: $NEWPW   (panelde Ayarlar'dan değiştirin)"; else echo " Parola: değişmedi (mevcut kurulum güncellendi)"; fi
echo "=========================================="
exit 0
